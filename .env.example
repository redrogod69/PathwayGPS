# PathwayGPS configuration — copy to .env (repository root) and edit. No secrets are required for the core app.

# NCBI E-utilities (ClinVar, PubMed): optional API key raises the limit from 3 to 10 requests/second.
# Register tool/email with NCBI: https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=PathwayGPS

# Response cache. Live mode re-fetches entries older than the TTL (seconds; default 7 days).
PATHWAYGPS_CACHE_DIR=
PATHWAYGPS_CACHE_TTL=604800
PATHWAYGPS_DISK_CACHE=1
PATHWAYGPS_HTTP_TIMEOUT=25

# Offline replay / demo mode: serve ONLY cached responses (never fetch). The UI labels this mode.
# Example: PATHWAYGPS_OFFLINE=1 with PATHWAYGPS_CACHE_DIR=backend/tests/fixtures/replay
PATHWAYGPS_OFFLINE=0

# Snapshots directory (default data/snapshots)
PATHWAYGPS_SNAPSHOT_DIR=

# Optional grounded AI synthesis (server-side only; never exposed to the browser).
# pip install -r backend/requirements-ai.txt
ANTHROPIC_API_KEY=
PATHWAYGPS_AI_MODEL=claude-opus-5-5
